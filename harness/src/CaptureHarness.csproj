<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>CaptureHarness</RootNamespace>
    <AssemblyName>CaptureHarness</AssemblyName>

    <!-- The Windows TFM is what turns on the WinRT projections (CsWinRT).
         22621 is chosen because it is widely present with any recent .NET 8 SDK
         and already contains everything WGC needs (added in 22000). -->
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>

    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>

    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Declares which sparse package this binary belongs to. Without it the
         process runs WITHOUT package identity even when the package is
         registered - see the comment in app.manifest. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

</Project>
